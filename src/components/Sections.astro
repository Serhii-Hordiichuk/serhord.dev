---
import type { Dict } from '../i18n/no';

interface Props {
  t: Dict;
}
const { t } = Astro.props;
---

<!-- TRUST -->
<section class="border-b border-[var(--color-line)] bg-[var(--color-cream)]">
  <div class="mx-auto max-w-6xl px-5 py-6">
    <p class="mono-label text-[var(--color-muted)]">{t.trust.label}</p>
    <div class="mt-3 flex flex-wrap gap-2.5">
      {t.trust.items.map((x) => (
        <span class="rounded-full border border-[var(--color-line)] bg-white px-4 py-1.5 text-sm font-medium">
          {x}
        </span>
      ))}
    </div>
  </div>
</section>

<!-- SERVICES -->
<section id="services" class="border-b border-[var(--color-line)]">
  <div class="mx-auto max-w-6xl px-5 py-16">
    <p class="mono-label text-[var(--color-accent)]">{t.services.label}</p>
    <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight md:text-[40px] md:leading-[1.1]" style="font-family: var(--font-display)">
      {t.services.title}
    </h2>
    <p class="mt-3 max-w-xl text-[var(--color-ink-soft)]">{t.services.sub}</p>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {t.services.cards.map((c) => (
        <article class="card-hover rounded-2xl border border-[var(--color-line)] bg-white p-6">
          <div class="flex items-center justify-between">
            <span class="grid h-11 w-11 place-items-center rounded-xl bg-[var(--color-ink)] text-xl text-[var(--color-lime)]">{c.icon}</span>
            <span class="font-mono text-xs text-[var(--color-muted)]">~/{c.id}</span>
          </div>
          <h3 class="mt-4 text-xl font-semibold">{c.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-[var(--color-ink-soft)]">{c.desc}</p>
          <ul class="mt-4 space-y-1.5 border-t border-dashed border-[var(--color-line)] pt-4 text-sm">
            {c.list.map((li) => (
              <li class="flex gap-2"><span class="text-[var(--color-accent)]">✓</span> {li}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <p class="mt-6 rounded-xl bg-[var(--color-amber-soft)] px-4 py-3 text-sm">
      ◉ {t.services.extrasTitle}
      {(t.services as any).extras.map((e: any, i: number, arr: any[]) => (
        <><a href="#pricing" class="font-semibold underline underline-offset-2 hover:no-underline">{e.t}</a>{i < arr.length - 1 ? ' · ' : ''}</>
      ))}
    </p>
  </div>
</section>

<!-- PROCESS -->
<section id="process" class="border-b border-[var(--color-line)] bg-[#101d2e] text-white">
  <div class="mx-auto max-w-6xl px-5 py-16">
    <p class="mono-label text-[var(--color-lime)]">{t.process.label}</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-[40px]" style="font-family: var(--font-display)">
      {t.process.title}
    </h2>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {t.process.steps.map((s) => (
        <div class="rounded-2xl border border-white/15 bg-white/5 p-6">
          <p class="font-mono text-sm text-[var(--color-lime)]">{s.n}</p>
          <h3 class="mt-2 text-lg font-semibold">{s.t}</h3>
          <p class="mt-2 text-sm leading-relaxed text-white/70">{s.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- PRICING -->
<section id="pricing" class="border-b border-[var(--color-line)]">
  <div class="mx-auto max-w-6xl px-5 py-16">
    <p class="mono-label text-[var(--color-accent)]">{t.pricing.label}</p>
    <h2 class="mt-3 text-3xl font-semibold tracking-tight md:text-[40px]" style="font-family: var(--font-display)">
      {t.pricing.title}
    </h2>
    <p class="mt-3 max-w-xl text-[var(--color-ink-soft)]">{t.pricing.sub}</p>
    <div class="mt-8 grid gap-4 md:grid-cols-3">
      {t.pricing.plans.map((p) => (
        <article
          class:list={[
            'card-hover relative rounded-2xl border p-6',
            p.popular ? 'border-[var(--color-ink)] bg-[var(--color-ink)] text-white shadow-[8px_8px_0_0_var(--color-accent)]' : 'border-[var(--color-line)] bg-white',
          ]}
        >
          {p.popular && (
            <span class="absolute -top-3 left-6 rounded-full bg-[var(--color-lime)] px-3 py-1 font-mono text-[11px] font-medium uppercase text-black">★ popular</span>
          )}
          <h3 class="text-lg font-semibold">{p.name}</h3>
          <p class="mt-1 text-2xl font-bold tracking-tight">{p.price}</p>
          <p class:list={['mt-1 text-sm', p.popular ? 'text-white/70' : 'text-[var(--color-ink-soft)]']}>{p.desc}</p>
          <ul class="mt-4 space-y-2 border-t border-dashed pt-4 text-sm" style={p.popular ? 'border-color: rgba(255,255,255,.2)' : ''}>
            {p.feats.map((f) => (
              <li class="flex gap-2"><span class={p.popular ? 'text-[var(--color-lime)]' : 'text-[var(--color-accent)]'}>✓</span> {f}</li>
            ))}
          </ul>
          <a href="#contact" class:list={['mt-6 block rounded-full py-2.5 text-center text-sm font-semibold', p.popular ? 'bg-[var(--color-lime)] text-black hover:bg-white' : 'bg-[var(--color-ink)] text-white hover:bg-black']}>
            {p.cta}
          </a>
        </article>
      ))}
    </div>
    <p class="mt-6 rounded-xl bg-[var(--color-amber-soft)] px-4 py-3 text-sm">◉ {t.pricing.note}</p>

    <div class="mt-3 rounded-xl bg-[var(--color-amber-soft)] px-4 py-2 text-sm">
      <p class="mono-label py-2 text-[var(--color-muted)]">{(t.pricing as any).extraTitle}</p>
      <ul class="divide-y divide-[var(--color-ink)]/10">
        {(t.pricing as any).extras.map((e: any) => (
          <li>
            <a href="#contact" class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5 py-2.5 hover:opacity-70">
              <span>◉ <strong>{e.name}</strong> — {e.desc}</span>
              <span class="ml-auto font-mono text-[13px] font-semibold whitespace-nowrap">{e.price} →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<!-- ETHICS + ABOUT -->
<section class="border-b border-[var(--color-line)] bg-[var(--color-cream)]">
  <div class="mx-auto grid max-w-6xl gap-4 px-5 py-16 md:grid-cols-2">
    <div class="rounded-2xl border border-[var(--color-line)] bg-white p-6">
      <p class="mono-label text-[var(--color-accent)]">{t.ethics.label}</p>
      <h2 class="mt-2 text-2xl font-semibold" style="font-family: var(--font-display)">{t.ethics.title}</h2>
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-[var(--color-accent)]">{t.ethics.doTitle}</p>
          <ul class="mt-2 space-y-2 text-sm leading-relaxed">
            {t.ethics.do.map((x) => (<li class="flex gap-2"><span>✓</span> {x}</li>))}
          </ul>
        </div>
        <div>
          <p class="text-sm font-bold uppercase tracking-wide text-red-700">{t.ethics.dontTitle}</p>
          <ul class="mt-2 space-y-2 text-sm leading-relaxed">
            {t.ethics.dont.map((x) => (<li class="flex gap-2"><span>✕</span> {x}</li>))}
          </ul>
        </div>
      </div>
    </div>
    <div id="about" class="rounded-2xl border border-[var(--color-ink)] bg-white p-6 shadow-[6px_6px_0_0_var(--color-ink)]">
      <p class="mono-label text-[var(--color-muted)]">{t.about.label}</p>
      <h2 class="mt-2 text-2xl font-semibold" style="font-family: var(--font-display)">{t.about.title}</h2>
      <p class="mt-3 text-[15px] leading-relaxed text-[var(--color-ink-soft)]">{t.about.text}</p>
      <ul class="mt-4 space-y-2 text-sm font-medium">
        {t.about.bullets.map((b) => (<li class="flex gap-2"><span class="text-[var(--color-accent)]">→</span> {b}</li>))}
      </ul>
    </div>
  </div>
</section>

<!-- FAQ -->
<section id="faq" class="border-b border-[var(--color-line)]">
  <div class="mx-auto max-w-3xl px-5 py-16">
    <p class="mono-label text-center text-[var(--color-accent)]">{t.faq.label}</p>
    <h2 class="mt-2 text-center text-3xl font-semibold" style="font-family: var(--font-display)">{t.faq.title}</h2>
    <div class="mt-8 space-y-3">
      {t.faq.items.map((f) => (
        <details class="group rounded-xl border border-[var(--color-line)] bg-white px-5 py-4 open:border-[var(--color-ink)]">
          <summary class="cursor-pointer list-none font-semibold marker:hidden">
            <span class="flex items-center justify-between gap-4">{f.q}<span class="text-[var(--color-muted)] group-open:rotate-45">＋</span></span>
          </summary>
          <p class="mt-2 text-[15px] leading-relaxed text-[var(--color-ink-soft)]">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
