---
import type { Dict } from '../i18n/no';

interface Props {
  t: Dict;
  lang: string;
}
const { t, lang } = Astro.props;
const ai = (t as any).ai;
---

<div id="ai-widget" data-lang={lang}>
  <button
    id="ai-fab"
    aria-label="Open AI manager"
    class="fixed bottom-5 right-5 z-[60] grid h-14 w-14 place-items-center rounded-full bg-[#101d2e] text-[var(--color-lime)] shadow-[4px_4px_0_0_var(--color-accent)] transition hover:-translate-y-0.5"
  >
    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1.5 0-3-.4-4.2-1L3 20l1.2-4.3A8.5 8.5 0 1 1 21 11.5z"/></svg>
    <span id="ai-dot" class="absolute -right-0.5 -top-0.5 h-3.5 w-3.5 rounded-full border-2 border-white bg-green-500"></span>
  </button>

  <div id="ai-tip" class="fixed bottom-[84px] right-5 z-[60] hidden max-w-[240px] rounded-xl border border-[var(--color-ink)] bg-white px-3 py-2 text-[13px] shadow-lg dark:bg-night">
    {ai.greet.slice(0, 90)}…
  </div>

  <section
    id="ai-panel"
    class="fixed inset-0 z-[61] hidden h-[100dvh] flex-col overflow-hidden bg-white dark:bg-night sm:inset-auto sm:bottom-5 sm:right-5 sm:h-auto sm:max-h-[calc(100dvh-2.5rem)] sm:min-h-[480px] sm:w-[min(400px,calc(100vw-2rem))] sm:rounded-2xl sm:border sm:border-[var(--color-ink)] sm:shadow-[8px_8px_0_0_var(--color-ink)]"
  >
    <header class="flex shrink-0 items-center justify-between bg-[#101d2e] px-4 py-3 text-white">
      <div class="flex items-center gap-2.5">
        <span class="grid h-8 w-8 place-items-center rounded-full bg-[var(--color-lime)] text-black"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5c-1.5 0-3-.4-4.2-1L3 20l1.2-4.3A8.5 8.5 0 1 1 21 11.5z"/></svg></span>
        <div>
          <p class="text-sm font-bold leading-none">{ai.name}</p>
        </div>
      </div>
      <button id="ai-close" aria-label="Close" class="grid h-8 w-8 place-items-center rounded-full text-white/70 hover:bg-white/10 hover:text-white"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg></button>
    </header>

    <div id="ai-messages" class="min-h-0 flex-1 space-y-2.5 overflow-y-auto overscroll-contain bg-[var(--color-paper)] p-4 text-sm"></div>

    <div id="ai-files" class="hidden shrink-0 flex-wrap gap-1.5 bg-white px-3 pt-2 dark:bg-night"></div>

    <form id="ai-form" class="flex shrink-0 items-center gap-1.5 bg-white p-3 dark:bg-night">
      <div class="relative w-full">
        <input
          id="ai-input"
          autocomplete="off"
          enterkeyhint="send"
          placeholder={ai.placeholder}
          class="w-full rounded-full border border-[var(--color-line)] py-2 pl-4 pr-[76px] text-base focus:border-black focus:outline-none dark:bg-night-soft sm:text-sm"
        />
        <label
          id="ai-attach-label"
          title={ai.attach}
          class="absolute right-10 top-1/2 grid h-8 w-8 -translate-y-1/2 cursor-pointer place-items-center rounded-full opacity-70 hover:bg-[var(--color-cream)] hover:opacity-100"
        >
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5l-8.5 8.5a5.5 5.5 0 0 1-7.8-7.8L12 5a3.7 3.7 0 0 1 5.2 5.2l-7.3 7.3a1.85 1.85 0 0 1-2.6-2.6L14 8"/></svg>
          <input
            id="ai-file"
            type="file"
            multiple
            class="hidden"
            accept=".txt,.md,.markdown,.csv,.json,.js,.ts,.tsx,.jsx,.html,.css,.pdf,.log,.xml,.yml,.yaml,text/*,image/*"
          />
        </label>
        <button
          id="ai-mic"
          type="button"
          title={ai.mic}
          class="absolute right-1.5 top-1/2 grid h-8 w-8 -translate-y-1/2 place-items-center rounded-full opacity-70 hover:bg-[var(--color-cream)] hover:opacity-100"
        >
          <svg class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 10a7 7 0 0 0 14 0"/><path d="M12 17v4"/></svg>
        </button>
      </div>
      <button class="shrink-0 rounded-full bg-[var(--color-accent)] px-4 py-2 text-sm font-bold text-white hover:bg-[var(--color-accent-dark)]">
        {ai.send}
      </button>
    </form>
    <div class="shrink-0 bg-white px-3 pb-3 dark:bg-night">
      <button
        id="ai-lead"
        class="hidden w-full rounded-full border border-[var(--color-ink)] bg-[var(--color-lime)] px-4 py-2 text-xs font-bold text-black hover:bg-white"
      >
        {ai.leadSend}
      </button>
    </div>
  </section>
</div>

<script define:vars={{ aiDict: ai }}>
  const root = document.getElementById('ai-widget');
  const fab = document.getElementById('ai-fab');
  const panel = document.getElementById('ai-panel');
  const closeBtn = document.getElementById('ai-close');
  const tip = document.getElementById('ai-tip');
  const box = document.getElementById('ai-messages');
  const form = document.getElementById('ai-form');
  const input = document.getElementById('ai-input');
  const micBtn = document.getElementById('ai-mic');
  const fileInput = document.getElementById('ai-file');
  const filesBar = document.getElementById('ai-files');
  const leadBtn = document.getElementById('ai-lead');

  const PAGE_LANG = root?.dataset.lang || 'no';

  const history = [];
  let pendingFiles = [];
  let aiReplies = 0;
  const MAX_FILES = 3;
  const MAX_FILE_BYTES = 100 * 1024;

  function bubble(who, text) {
    const wrap = document.createElement('div');
    wrap.className = who === 'me' ? 'flex justify-end' : 'flex justify-start';
    const b = document.createElement('div');
    b.className = who === 'me'
      ? 'max-w-[85%] rounded-2xl rounded-br-sm bg-[#101d2e] px-3.5 py-2.5 text-white dark:bg-[#2b3d63]'
      : 'max-w-[85%] rounded-2xl rounded-bl-sm border border-[var(--color-line)] bg-white px-3.5 py-2.5 dark:bg-night-soft';
    b.innerHTML = text;
    wrap.appendChild(b);
    box.appendChild(wrap);
    box.scrollTop = box.scrollHeight;
    return b;
  }

  function esc(s) {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\n/g, '<br>');
  }

  function localBrain(q) {
    const s = q.toLowerCase();
    const CTA = `<br><br><a href="#contact" style="font-weight:700;text-decoration:underline">→ ${aiDict.offerCta}</a>`;
    const has = (...ws) => ws.some((w) => s.includes(w));
    if (has('virus', 'treg', 'slow', 'malware', 'antivirus')) return (PAGE_LANG === 'no'
      ? `<b>Virus-rens fra 990 kr:</b> rens + antivirus + nettleser/e-post-herding + 2FA. Tar 1–2 dager, du får logg over alt som ble fjernet. <b>Uimotståelig:</b> rens + OS-helsesjekk + backup-oppsett i samme slengen — si ifra så reserverer jeg tid i morgen.`
      : `<b>Malware cleanup from NOK 990:</b> cleanup + antivirus + browser/email hardening + 2FA. 1–2 days with a removal log. <b>Deal:</b> cleanup + health check + backup setup together — I can start tomorrow.`) + CTA;
    if (has('windows', 'linux', 'chromeos', 'chrome os', 'install', 'installer', 'ubuntu', 'mint')) return (PAGE_LANG === 'no'
      ? `<b>OS-install fra 790 kr:</b> Windows, Ubuntu/Mint eller ChromeOS Flex — drivere, norsk språk, printer og WiFi ferdig. Tar med backup av filene dine først. <b>Bonus:</b> SSD-sjekk gratis under install.`
      : `<b>OS install from NOK 790:</b> Windows, Ubuntu/Mint or ChromeOS Flex — drivers, language, printer & WiFi ready. Files backed up first. <b>Bonus:</b> free SSD health check during install.`) + CTA;
    if (has('ssd', 'ram', 'skjerm', 'batteri', 'repair', 'reparasjon', 'screen', 'battery', 'vifte', 'kjøling')) return (PAGE_LANG === 'no'
      ? `<b>Reparasjon:</b> SSD/RAM-oppgradering (vanligvis 1500–3500 kr inkl. deler), skjerm/batteri etter modell. Du får fastpris FØR jeg skrur. Send modellnavn så sjekker jeg deler i dag.`
      : `<b>Repair:</b> SSD/RAM upgrade (typically NOK 1500–3500 incl. parts), screen/battery per model. Fixed quote BEFORE I open it. Send the model name and I'll check parts today.`) + CTA;
    if (has('server', 'nas', 'nextcloud', 'vpn', 'lokal', 'lagring', 'backup')) return (PAGE_LANG === 'no'
      ? `<b>Lokal server/NAS:</b> Nextcloud + backup 3-2-1 + VPN — familien eller kontoret eier dataene selv, ingen månedsavgift til USA-skyer. Fra ca. 6900 kr inkl. oppsett.`
      : `<b>Local server/NAS:</b> Nextcloud + 3-2-1 backup + VPN — you own the data, no US-cloud monthly fee. From ~NOK 6900 incl. setup.`) + CTA;
    if (has('nettside', 'website', 'nettbutikk', 'landing', 'side', 'seo')) return (PAGE_LANG === 'no'
      ? `◧ <b>Nettside:</b> Start fra 5900 kr (7–10 dager) eller Business OS fra 17900 kr (side + booking + e-post + drift + KI). 90+ Lighthouse, du eier domene og kode. <b>Foreslår:</b> gratis 15-min intro i dag → fastpris i morgen.`
      : `◧ <b>Website:</b> Start from NOK 5900 (7–10 days) or Business OS from NOK 17900 (site + booking + email + ops + AI). 90+ Lighthouse, you own domain & code. <b>Suggest:</b> free 15-min intro today → fixed quote tomorrow.`) + CTA;
    if (has('ki', ' ai', 'chatbot', 'rag', 'automatis')) return (PAGE_LANG === 'no'
      ? `✦ <b>KI på dine data:</b> chatbot på nettsiden + svar fra dine dokumenter (RAG), EU-hosting, logging av hva modellen ser. Pilot fra ca. 8900 kr. Send 2–3 eksempel-dokumenter så lager jeg demo.`
      : `✦ <b>AI on your data:</b> site chatbot + answers from your docs (RAG), EU hosting, model-access logging. Pilot from ~NOK 8900. Send 2–3 sample docs and I'll build a demo.`) + CTA;
    if (has('osint', 'owasp', 'lekkas', 'leak', 'personvern', 'privacy', 'sikkerhet', 'security', 'passord', 'svindel', 'hack')) return (PAGE_LANG === 'no'
      ? `◎ <b>Sikkerhetssjekk fra 2900 kr:</b> lekkasje/passord, OWASP Top-10 nettside-sjekk, personvern-opprydding (trackere, 2FA, backup). Kun lovlig: åpne kilder + ditt samtykke, skriftlig rapport med fiks.`
      : `◎ <b>Security check from NOK 2900:</b> leak/password, OWASP Top-10 site check, privacy cleanup (trackers, 2FA, backup). Legal only: open sources + your consent, written fix report.`) + CTA;
    if (has('pris', 'price', 'kost', 'cost', 'koster')) return (PAGE_LANG === 'no'
      ? `<b>Faste priser:</b> Start 5900 kr • Business OS 17900 kr • Care 990 kr/mnd • OSINT 2900 kr • virus-rens 990 kr • OS-install 790 kr. Alt eks. mva, skriftlig tilbud, ingen binding. Hva passer best for deg?`
      : `<b>Fixed prices (NOK):</b> Start 5900 • Business OS 17900 • Care 990/mo • OSINT 2900 • cleanup 990 • OS install 790. Written quote, no lock-in. Which fits you?`) + CTA;
    if (has('hei', 'hallo', 'hello', 'hi', 'hjelp', 'help')) return (PAGE_LANG === 'no'
      ? `Hei! Si kort hva som plager deg — treg PC, nettside, e-post, sikkerhet? Jeg svarer med konkret pakke + fastpris med en gang.`
      : `Hi! Briefly say what bothers you — slow PC, website, email, security? I'll reply with a concrete package + fixed price right away.`);
    return (PAGE_LANG === 'no'
      ? `Skjønner! For å gi deg <b>best mulig tilbud med en gang</b>: er det (1) PC/server, (2) nettside, (3) KI eller (4) sikkerhet/personvern? Svar med ett tall — så sender jeg pakke + fastpris + ledig tid.`
      : `Got it! To give you the <b>best offer right away</b>: is it (1) PC/server, (2) website, (3) AI or (4) security/privacy? Reply with one number — I'll send package + price + slot.`);
  }

  function offlineFallback(q, files) {
    let fallback = localBrain(q);
    if (files && files.length) {
      fallback += `<br><br>${esc(PAGE_LANG === 'no'
        ? 'NB: Vedleggene dine ser jeg først når nett-manageren er på nett — ta dem med i kontaktskjemaet under, så leser vi alt før intro-møtet.'
        : 'NB: I’ll see your attachments once the online manager is back — include them in the contact form below and we’ll read everything before the intro call.')}`;
    }
    return fallback;
  }

  async function askAI(q, files, el) {
    history.push({ role: 'user', content: q });
    let full = '';
    try {
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ messages: history.slice(-12), lang: PAGE_LANG, attachments: files }),
      });
      if (!res.ok || !res.body) throw new Error('chat ' + res.status);
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buf = '';
      for (;;) {
        const { done, value } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        const lines = buf.split('\n');
        buf = lines.pop() || '';
        for (const line of lines) {
          const t = line.trim();
          if (!t.startsWith('data:')) continue;
          const payload = t.slice(5).trim();
          if (payload === '[DONE]') continue;
          try {
            const tok = JSON.parse(payload).token || '';
            if (tok) {
              full += tok;
              el.innerHTML = esc(full) + '▍';
              box.scrollTop = box.scrollHeight;
            }
          } catch {
            // битий чанк — пропускаємо
          }
        }
      }
      if (!full.trim()) throw new Error('empty');
      history.push({ role: 'assistant', content: full });
      aiReplies += 1;
      leadBtn?.classList.remove('hidden');
      // CTA-посилання — тільки з другої відповіді; перша завжди чисте знайомство
      el.innerHTML = aiReplies > 1
        ? esc(full) + `<br><br><a href="#contact" style="font-weight:700;text-decoration:underline">→ ${aiDict.offerCta}</a>`
        : esc(full);
    } catch (e) {
      if (full.trim()) {
        // Стрім обірвався посеред відповіді — лишаємо часткове
        history.push({ role: 'assistant', content: full });
        aiReplies += 1;
        leadBtn?.classList.remove('hidden');
        el.innerHTML = esc(full);
      } else {
        el.innerHTML = offlineFallback(q, files);
      }
    }
    box.scrollTop = box.scrollHeight;
  }

  async function sendUserMessage(q, files) {
    open();
    const shown = files && files.length
      ? `${esc(q)}<br><span style="font-size:12px;opacity:.8">▣ ${files.map((f) => esc(f.name)).join(', ')}</span>`
      : esc(q);
    bubble('me', shown || '…');
    const t = bubble('ai', '…');
    await askAI(q, files || [], t);
  }

  // ---- Attachments: текст/код читаємо локально, картинки — ввічливе «ні» ----
  function renderFileChips() {
    if (!pendingFiles.length) {
      filesBar.classList.add('hidden');
      filesBar.classList.remove('flex');
      filesBar.innerHTML = '';
      return;
    }
    filesBar.classList.remove('hidden');
    filesBar.classList.add('flex');
    filesBar.innerHTML = '';
    pendingFiles.forEach((f, i) => {
      const chip = document.createElement('span');
      chip.className = 'inline-flex max-w-full items-center gap-1 rounded-full border border-[var(--color-line)] bg-[var(--color-paper)] px-2.5 py-1 font-mono text-[11px]';
      const label = document.createElement('span');
      label.className = 'truncate';
      label.textContent = `▣ ${f.name}`;
      const x = document.createElement('button');
      x.type = 'button';
      x.title = aiDict.removeFile;
      x.textContent = '✕';
      x.className = 'font-bold hover:text-red-600';
      x.addEventListener('click', () => {
        pendingFiles.splice(i, 1);
        renderFileChips();
      });
      chip.appendChild(label);
      chip.appendChild(x);
      filesBar.appendChild(chip);
    });
  }

  fileInput?.addEventListener('change', async () => {
    const picked = Array.from(fileInput.files || []);
    fileInput.value = '';
    for (const file of picked) {
      if (pendingFiles.length >= MAX_FILES) break;
      if (/^image\//.test(file.type) || /\.(png|jpe?g|gif|webp|bmp|svg|heic)$/i.test(file.name)) {
        open();
        bubble('ai', esc(aiDict.imageUnsupported));
        continue;
      }
      if (file.size > MAX_FILE_BYTES) {
        open();
        bubble('ai', esc(aiDict.fileTooBig));
        continue;
      }
      try {
        const text = (await file.text()).slice(0, 30000);
        if (!text.trim()) throw new Error('empty');
        pendingFiles.push({ name: file.name, text });
      } catch {
        open();
        bubble('ai', esc(aiDict.fileUnreadable));
      }
    }
    renderFileChips();
    if (pendingFiles.length) open();
    setTimeout(() => input?.focus(), 50);
  });

  // ---- Voice: Web Speech API (безкоштовно, вбудовано в браузер) ----
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  let recog = null;
  let listening = false;
  if (!SR) {
    micBtn.style.display = 'none';
  } else {
    micBtn?.addEventListener('click', () => {
      if (listening && recog) {
        recog.stop();
        return;
      }
      try {
        recog = new SR();
        recog.lang = PAGE_LANG === 'no' ? 'nb-NO' : 'en-US';
        recog.interimResults = true;
        recog.maxAlternatives = 1;
        let base = input.value ? input.value + ' ' : '';
        recog.onresult = (ev) => {
          let interim = '';
          let final = '';
          for (let i = ev.resultIndex; i < ev.results.length; i++) {
            const tr = ev.results[i][0].transcript;
            if (ev.results[i].isFinal) final += tr + ' ';
            else interim += tr;
          }
          input.value = (base + final + interim).trim();
        };
        recog.onend = () => {
          listening = false;
          micBtn.classList.remove('bg-[var(--color-lime)]');
          micBtn.title = aiDict.mic;
        };
        recog.onerror = () => {
          listening = false;
          micBtn.classList.remove('bg-[var(--color-lime)]');
          micBtn.title = aiDict.mic;
          open();
          bubble('ai', esc(aiDict.voiceError));
        };
        recog.onstart = () => {
          listening = true;
          base = input.value ? input.value + ' ' : '';
          micBtn.classList.add('bg-[var(--color-lime)]');
          micBtn.title = aiDict.micListening;
          open();
        };
        recog.start();
      } catch {
        open();
        bubble('ai', esc(aiDict.voiceError));
      }
    });
  }

  // ---- Lead handoff: саммарі діалогу → форма #contact ----
  leadBtn?.addEventListener('click', () => {
    const lines = history.slice(-6).map((m) => `${m.role === 'user' ? 'Kunde' : 'AI'}: ${m.content}`.slice(0, 600));
    const summary = lines.join('\n').slice(0, 1500);
    const formEl = document.getElementById('contact-form');
    const msgField = formEl?.querySelector('textarea[name="message"]');
    if (msgField && !msgField.value) {
      msgField.value = `${PAGE_LANG === 'no' ? 'Hei! Jeg snakket med AI-manageren: ' : 'Hi! I talked to the AI manager: '}\n${summary}`;
    }
    bubble('ai', esc(aiDict.leadDone));
    setTimeout(() => {
      document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
      closePanel();
    }, 900);
  });

  let opened = false;
  function open() {
    panel.classList.remove('hidden');
    panel.classList.add('flex');
    lockPageScroll();
    tip.classList.add('hidden');
    if (!opened) {
      opened = true;
      bubble('ai', esc(aiDict.greet || ''));
    }
    setTimeout(() => input?.focus(), 50);
  }
  function closePanel() {
    panel.classList.add('hidden');
    panel.classList.remove('flex');
    unlockPageScroll();
  }
  // Поки діалог відкритий — взаємодія тільки з ним: фон не скролиться
  // (на мобайлі фон під повноекранним чатом інакше "їде" і ламає верстку).
  function lockPageScroll() {
    document.body.style.overflow = 'hidden';
    document.documentElement.style.overflow = 'hidden';
  }
  function unlockPageScroll() {
    document.body.style.overflow = '';
    document.documentElement.style.overflow = '';
  }
  // Поле вводу завжди видно над мобільною клавіатурою:
  // на вузьких екранах підганяємо висоту панелі під видиму область.
  const isMobileView = () => window.matchMedia('(max-width: 639px)').matches;
  if (window.visualViewport) {
    window.visualViewport.addEventListener('resize', () => {
      if (!panel.classList.contains('hidden') && isMobileView()) {
        panel.style.height = `${window.visualViewport.height}px`;
      } else {
        panel.style.height = '';
      }
    });
  }
  input?.addEventListener('focus', () => {
    setTimeout(() => {
      box.scrollTop = box.scrollHeight;
      input.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }, 300);
  });
  fab?.addEventListener('click', () => {
    if (panel.classList.contains('hidden')) {
      panel.style.height = '';
      open();
    } else {
      closePanel();
    }
  });
  closeBtn?.addEventListener('click', closePanel);
  setTimeout(() => { if (!opened) tip.classList.remove('hidden'); }, 6000);
  setTimeout(() => tip.classList.add('hidden'), 16000);

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const q = input.value.trim();
    if (!q && !pendingFiles.length) return;
    const files = pendingFiles;
    pendingFiles = [];
    renderFileChips();
    input.value = '';
    await sendUserMessage(q || (PAGE_LANG === 'no' ? 'Se vedleggene og foreslå pakke.' : 'See the attachments and suggest a package.'), files);
  });
</script>
