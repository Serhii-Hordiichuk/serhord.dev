---
import type { Dict } from '../i18n/no';

interface Props {
  t: Dict;
  lang: string;
}
const { t, lang } = Astro.props;
---

<section class="paper-grid relative overflow-hidden border-b border-[var(--color-line)]">
  <div class="mx-auto grid max-w-6xl gap-10 px-5 pb-16 pt-14 md:grid-cols-[1.15fr_0.85fr] md:pt-20">
    <div class="reveal">
      <p class="mono-label text-[var(--color-accent)]">{t.hero.eyebrow}</p>
      <h1
        class="mt-4 font-display text-[42px] font-semibold leading-[1.02] tracking-tight md:text-[64px]"
        style="font-family: var(--font-display)"
      >
        {t.hero.titleA}<br />
        <span class="italic">{t.hero.titleB}</span>
      </h1>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-[var(--color-ink-soft)]">{t.hero.sub}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href={`/${lang}/#contact`}
          class="rounded-full bg-[var(--color-accent)] px-6 py-3 text-[15px] font-semibold text-white hover:bg-[var(--color-accent-dark)]"
        >
          {t.hero.ctaPrimary}
        </a>
        <a
          href={`/${lang}/#services`}
          class="rounded-full border border-[var(--color-ink)] px-6 py-3 text-[15px] font-semibold hover:bg-[var(--color-ink)] hover:text-white dark:hover:bg-white dark:hover:text-black"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-4 text-sm text-[var(--color-ink-soft)]">
        <span class="inline-flex items-center gap-2">
          <span class="status-dot inline-block h-2.5 w-2.5 rounded-full bg-green-500"></span>
          {t.hero.status}
        </span>
        <span class="hidden h-4 w-px bg-[var(--color-line)] sm:block"></span>
        <span>✉ {t.hero.response}</span>
      </div>
    </div>

    <div class="reveal" style="animation-delay: 0.15s">
      <div class="overflow-hidden rounded-2xl border border-[var(--color-ink)] bg-white shadow-[8px_8px_0_0_var(--color-ink)] dark:bg-night" translate="no">
        <div class="flex items-center gap-2 border-b border-[var(--color-line)] bg-[var(--color-cream)] px-4 py-2.5">
          <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
          <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
          <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
          <span class="notranslate ml-2 font-mono text-xs text-[var(--color-muted)]">{t.hero.terminalTitle}</span>
        </div>
        <div class="notranslate space-y-2.5 bg-[#0f1d2e] p-5 font-mono text-[13px] leading-relaxed text-green-200">
          <p><span class="text-gray-500">$</span> uptime --site serhord.dev</p>
          <p>✓ <span class="text-white">deploy ok</span> <span class="text-gray-400">— 214ms edge</span></p>
          <p>✓ backup daily <span class="text-gray-400">— tested restore</span></p>
          <p>✓ headers <span class="text-gray-400">— CSP / HSTS on</span></p>
          <p class="text-lime-200">→ ready for small business_</p>
        </div>
        <div class="grid grid-cols-3 divide-x divide-[var(--color-line)] bg-white text-center dark:bg-night">
          <div class="px-2 py-3 text-xs font-semibold">{t.hero.proof1}</div>
          <div class="px-2 py-3 text-xs font-semibold">{t.hero.proof2}</div>
          <div class="px-2 py-3 text-xs font-semibold">{t.hero.proof3}</div>
        </div>
      </div>
      <p class="mt-3 text-center font-mono text-xs text-[var(--color-muted)]">{t.hero.cardNote}</p>
    </div>
  </div>
</section>
