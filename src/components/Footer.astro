---
import type { Dict } from '../i18n/no';

interface Props {
  t: Dict;
  lang: string;
}
const { t, lang } = Astro.props;
---

<footer class="border-t border-[var(--color-line)] bg-[var(--color-paper)]">
  <div class="mx-auto max-w-6xl px-5 py-10">
    <div class="flex flex-col justify-between gap-6 md:flex-row md:items-start">
      <div>
        <p class="font-mono text-lg">serhord<span class="text-[var(--color-accent)]">.dev_</span></p>
        <p class="mt-2 max-w-sm text-sm text-[var(--color-ink-soft)]">{t.footer.tagline}</p>
        <p class="mt-3 text-sm font-semibold">
          <a href="tel:+4796689237" class="hover:underline">✆ {(t.footer as any).phone}</a>
          <span class="font-normal text-[var(--color-ink-soft)]"> · {(t.footer as any).area}</span>
        </p>
      </div>
      <nav class="flex gap-4 text-sm">
        <a href={`/${lang}/`} class="hover:underline">↑ top</a>
        <a href="#services" class="hover:underline">{t.nav.services}</a>
        <a href="#contact" class="hover:underline">{t.nav.cta}</a>
      </nav>
    </div>
    <div class="mt-8 flex flex-col gap-2 border-t border-[var(--color-line)] pt-6 font-mono text-xs text-[var(--color-muted)] md:flex-row md:justify-between">
      <p>{t.footer.rights}</p>
      <p>{t.footer.stack}</p>
    </div>
  </div>
</footer>
