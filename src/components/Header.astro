---
import type { Dict } from '../i18n/no';

interface Props {
  t: Dict;
  lang: string;
}
const { t, lang } = Astro.props;
const other = lang === 'no' ? 'en' : 'no';
---

<header class="sticky top-0 z-50 border-b border-[var(--color-line)] bg-[var(--color-paper)]/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
    <a href={`/${lang}/`} class="font-mono text-[15px] font-medium tracking-tight" translate="no">
      <span class="notranslate">serhord<span class="text-[var(--color-accent)]">.dev_</span></span>
    </a>
    <nav class="hidden items-center gap-6 text-sm text-[var(--color-ink-soft)] md:flex" aria-label="Main">
      <a href={`/${lang}/#services`} class="hover:text-black">{t.nav.services}</a>
      <a href={`/${lang}/#process`} class="hover:text-black">{t.nav.process}</a>
      <a href={`/${lang}/#pricing`} class="hover:text-black">{t.nav.pricing}</a>
      <a href={`/${lang}/#about`} class="hover:text-black">{t.nav.about}</a>
      <a href={`/${lang}/#faq`} class="hover:text-black">{t.nav.faq}</a>
    </nav>
    <div class="flex items-center gap-2">
      <button
        id="theme-toggle"
        type="button"
        class="grid h-8 w-8 place-items-center rounded-full border border-[var(--color-line)] text-base hover:border-black"
        aria-label={t.nav.theme}
        title={t.nav.theme}
      >
        <span id="theme-icon-moon"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg></span>
        <span id="theme-icon-sun" class="hidden"><svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span>
      </button>
      <a
        href={`/${other}/`}
        class="lang-switch rounded-full border border-[var(--color-line)] px-3 py-1.5 font-mono text-xs uppercase hover:border-black"
        aria-label={t.nav.langLabel}
      >
        {other}
      </a>
      <a
        href={`/${lang}/#contact`}
        class="rounded-full bg-[var(--color-ink)] px-4 py-1.5 text-sm font-medium text-white hover:bg-black dark:bg-[var(--color-lime)] dark:text-black dark:hover:bg-white"
      >
        {t.nav.cta}
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    const btn = document.getElementById('theme-toggle');
    const sun = document.getElementById('theme-icon-sun');
    const moon = document.getElementById('theme-icon-moon');
    function sync() {
      const dark = document.documentElement.classList.contains('dark');
      sun?.classList.toggle('hidden', !dark);
      moon?.classList.toggle('hidden', dark);
    }
    btn?.addEventListener('click', () => {
      const dark = document.documentElement.classList.toggle('dark');
      try {
        localStorage.setItem('theme', dark ? 'dark' : 'light');
      } catch (e) {}
      sync();
    });
    try {
      if (!localStorage.getItem('theme')) {
        matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          document.documentElement.classList.toggle('dark', e.matches);
          sync();
        });
      }
    } catch (e) {}
    sync();
  })();
</script>
