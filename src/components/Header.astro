---
import type { Dict } from '../i18n/no';

interface Props {
  t: Dict;
  lang: string;
}
const { t, lang } = Astro.props;
const other = lang === 'no' ? 'en' : 'no';
---

<header class="sticky top-0 z-50 border-b border-[var(--color-line)] bg-[var(--color-paper)]/90 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-3">
    <a href={`/${lang}/`} class="font-mono text-[15px] font-medium tracking-tight">
      serhord<span class="text-[var(--color-accent)]">.dev_</span>
    </a>
    <nav class="hidden items-center gap-6 text-sm text-[var(--color-ink-soft)] md:flex">
      <a href="#services" class="hover:text-black">{t.nav.services}</a>
      <a href="#process" class="hover:text-black">{t.nav.process}</a>
      <a href="#pricing" class="hover:text-black">{t.nav.pricing}</a>
      <a href="#about" class="hover:text-black">{t.nav.about}</a>
      <a href="#faq" class="hover:text-black">{t.nav.faq}</a>
    </nav>
    <div class="flex items-center gap-2">
      <a
        href={`/${other}/`}
        class="rounded-full border border-[var(--color-line)] px-3 py-1.5 font-mono text-xs uppercase hover:border-black"
        aria-label="Switch language"
      >
        {other}
      </a>
      <a
        href="#contact"
        class="rounded-full bg-[var(--color-ink)] px-4 py-1.5 text-sm font-medium text-white hover:bg-black"
      >
        {t.nav.cta}
      </a>
    </div>
  </div>
</header>
