# Copy to .env — never commit real keys
PUBLIC_CAL_LINK=https://cal.com/serhord/intro
PUBLIC_FORMSPOREE_ID=
PUBLIC_TURNSTILE_SITE_KEY=

# --- AI manager (OpenRouter) ---
# SECRET — тільки сервер! Без префікса PUBLIC_, інакше ключ витече в браузер.
# Vercel → Settings → Environment Variables → OPENROUTER_API_KEY (Sensitive, Production+Preview)
# Get key: https://openrouter.ai/keys — restrict by HTTP referrer serhord.dev
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SITE_URL=https://serhord.dev

